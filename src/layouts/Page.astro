---
/** Layout for simple text pages (guide, rules, privacy). */
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  intro?: string;
  noindex?: boolean;
}
const { title, description, intro, noindex } = Astro.props;
---

<Base title={title} description={description} noindex={noindex}>
  <div class="page-top">
    <div class="shell pt-36 pb-10 sm:pt-44">
      <h1 class="text-[clamp(2.6rem,6vw,4.25rem)] font-extrabold">{title}</h1>
      {intro && <p class="lede mt-4">{intro}</p>}
    </div>
  </div>
  <div class="shell pb-24">
    <div class="prose">
      <slot />
    </div>
  </div>
</Base>

<style>
  .page-top {
    background:
      radial-gradient(40rem 20rem at 85% 0%, rgb(232 141 165 / 0.16), transparent 70%),
      radial-gradient(34rem 18rem at 20% 0%, rgb(142 213 163 / 0.1), transparent 70%);
  }
</style>
