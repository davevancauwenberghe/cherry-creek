---
import Base from '@/layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <div class="shell grid min-h-[80svh] place-content-center justify-items-start pt-32 pb-20">
    <p class="pixel text-2xl text-sand">404</p>
    <h1 class="mt-3 text-[clamp(2.6rem,6vw,4.25rem)] font-extrabold">
      You've wandered off the map
    </h1>
    <p class="lede mt-4">There's nothing at this address. The path home is this way.</p>
    <a href="/" class="btn btn-primary mt-8">
      Back to Cherry Creek
    </a>
  </div>
</Base>
