---
import { Image } from 'astro:assets';
import campScene from '@/assets/art/camp-scene.png';
import { site } from '@/config/site';
import Icon from './Icon.astro';

const discord = [
  {
    title: 'Shared chat',
    body: 'Messages flow both ways between Minecraft and the #minecraft channel.',
  },
  { title: 'Comings and goings', body: 'See when players join and leave the server.' },
  {
    title: 'Deaths, advancements and shop sales',
    body: 'Triumphs, mishaps and server shop transactions are announced as they happen.',
  },
  {
    title: 'Optional account linking',
    body: 'Link your Minecraft account with /discord link to receive the Minecrafter role. It does not replace the whitelist.',
  },
];
---

<section id="community" class="section" aria-labelledby="community-heading">
  <div class="shell">
    <figure data-reveal>
      <Image
        src={campScene}
        alt="Pixel-art illustration of the campfire clearing on Cherry Creek: benches around a fire, lamp posts and small huts under cherry trees"
        widths={[640, 1024, 1600, 1920]}
        sizes="(min-width: 80rem) 72rem, 100vw"
        quality={90}
        loading="lazy"
        class="aspect-[16/10] w-full rounded-4xl border border-(--line) object-cover object-[50%_60%] sm:aspect-[2/1] lg:aspect-[21/9]"
      />
      <figcaption class="mt-3 text-sm text-silver lg:max-w-[calc(100%-28rem)]">
        The campfire clearing on Cherry Creek, redrawn from an in-game screenshot.
      </figcaption>
    </figure>

    <div class="mt-10 grid gap-10 lg:mt-4 lg:grid-cols-[minmax(0,1fr)_25rem] lg:gap-14">
      <div class="lg:pt-10">
        <h2 id="community-heading" class="section-title">
          A place for builders, explorers and easy-going survivalists
        </h2>
        <p class="lede mt-5">
          Cherry Creek is small on purpose. Come as you are, play at your own pace, and get to know
          the people you share a world with.
        </p>
        <a href={site.discordUrl} class="btn btn-quiet mt-8" target="_blank" rel="noopener">
          Join the Discord
          <Icon name="external" size={16} />
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>

      <!-- On wide screens the card rises over the corner of the scene, so the glass has something to catch. -->
      <div class="glass relative rounded-3xl p-6 sm:p-7 lg:-mt-44 lg:mr-8" data-reveal>
        <h3 class="font-sans text-sm font-medium tracking-normal text-silver">
          On Discord, through DiscordSRV
        </h3>
        <ul class="mt-2 divide-y divide-(--line)">
          {discord.map((item) => (
            <li class="py-3.5 last:pb-0">
              <p class="font-semibold text-snow">{item.title}</p>
              <p class="mt-0.5 text-[0.95rem] text-snow/75">{item.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
