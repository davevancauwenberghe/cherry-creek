---
/**
 * Searchable command reference. Works as a plain list without JavaScript;
 * src/scripts/guide.ts adds filtering, and the shared copy handler makes each
 * command copyable.
 */
const categories = ['Homes', 'Teleport', 'Money', 'Claims'] as const;

const commands: { command: string; does: string; category: (typeof categories)[number] }[] = [
  { command: '/sethome', does: 'Save your current location as a home.', category: 'Homes' },
  { command: '/sethome <name>', does: 'Create a named home.', category: 'Homes' },
  { command: '/home', does: 'Return to your home or select one.', category: 'Homes' },
  { command: '/home <name>', does: 'Teleport to a named home.', category: 'Homes' },
  { command: '/delhome <name>', does: 'Delete a saved home.', category: 'Homes' },
  { command: '/tpa <player>', does: 'Ask to teleport to another player.', category: 'Teleport' },
  { command: '/tpaccept', does: 'Accept a teleport request.', category: 'Teleport' },
  { command: '/tpdeny', does: 'Decline a teleport request.', category: 'Teleport' },
  { command: '/balance', does: 'Check your balance.', category: 'Money' },
  {
    command: '/pay <player> <amount>',
    does: 'Send in-game money to another player.',
    category: 'Money',
  },
  { command: '/shop', does: 'Open the server shop.', category: 'Money' },
  { command: '/market', does: 'Alternative command for the shop.', category: 'Money' },
  { command: '/sellgui', does: 'Open the selling interface.', category: 'Money' },
  { command: '/sellall', does: "Access the shop's bulk-selling command.", category: 'Money' },
  { command: '/buyclaimblocks <amount>', does: 'Purchase extra claim blocks.', category: 'Claims' },
  {
    command: '/claimslist',
    does: 'View your claims and available claim blocks.',
    category: 'Claims',
  },
  {
    command: '/trust <player>',
    does: 'Allow another player to build in your claim.',
    category: 'Claims',
  },
  {
    command: '/containertrust <player>',
    does: 'Allow access to protected containers and equipment.',
    category: 'Claims',
  },
  {
    command: '/accesstrust <player>',
    does: 'Allow basic interactions in your claim.',
    category: 'Claims',
  },
  {
    command: '/untrust <player>',
    does: "Remove a player's claim permissions.",
    category: 'Claims',
  },
  { command: '/trustlist', does: 'Display trusted players for your claim.', category: 'Claims' },
  { command: '/abandonclaim', does: "Delete the claim you're standing in.", category: 'Claims' },
];

/** What lands on the clipboard: the command up to its first placeholder. */
const typed = (command: string) =>
  command.includes('<') ? command.slice(0, command.indexOf('<')) : command;
---

<div class="not-prose finder" data-finder>
  <div class="finder-controls" data-finder-controls hidden>
    <label class="sr-only" for="finder-search">
      Search commands
    </label>
    <input
      id="finder-search"
      class="finder-search"
      type="search"
      placeholder="Search commands, for example “home” or “sell”"
      autocomplete="off"
      spellcheck="false"
      data-finder-search
    />
    <div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="Filter by topic">
      <button type="button" class="finder-chip" aria-pressed="true" data-finder-category="">
        All
      </button>
      {categories.map((category) => (
        <button
          type="button"
          class="finder-chip"
          aria-pressed="false"
          data-finder-category={category}
        >
          {category}
        </button>
      ))}
    </div>
  </div>

  <ul class="mt-4">
    {commands.map((item) => (
      <li
        class="finder-row"
        data-finder-row
        data-category={item.category}
        data-text={`${item.command} ${item.does} ${item.category}`.toLowerCase()}
      >
        <button
          type="button"
          class="finder-command"
          data-copy={typed(item.command)}
          aria-label={`Copy ${item.command}`}
        >
          <span data-copy-label data-label-default={item.command}>
            {item.command}
          </span>
        </button>
        <p class="text-silver">{item.does}</p>
      </li>
    ))}
  </ul>
  <p class="mt-4 text-sm text-silver" role="status" data-finder-count>
    {commands.length} commands. Select one to copy it.
  </p>
</div>

<style>
  .finder-search {
    width: 100%;
    min-height: 3rem;
    padding: 0.6rem 1rem;
    border-radius: 0.9rem;
    border: 1px solid var(--line-strong);
    background: rgb(13 21 24 / 0.6);
    color: var(--color-snow);
  }
  .finder-search::placeholder {
    color: rgb(169 181 181 / 0.75);
  }
  .finder-chip {
    min-height: 2.25rem;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--color-snow);
    font-size: 0.925rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .finder-chip:hover {
    background: rgb(244 245 244 / 0.08);
  }
  .finder-chip[aria-pressed='true'] {
    background: var(--color-sand);
    border-color: var(--color-sand);
    color: #2a2418;
  }
  .finder-row {
    display: grid;
    gap: 0.35rem 1.25rem;
    padding-block: 0.7rem;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 40rem) {
    .finder-row {
      grid-template-columns: 15.5rem 1fr;
      align-items: center;
    }
  }
  .finder-row[hidden] {
    display: none;
  }
  .finder-command {
    justify-self: start;
    padding: 0.3rem 0.65rem;
    border-radius: 0.55rem;
    border: 1px solid transparent;
    background: rgb(244 245 244 / 0.08);
    color: var(--color-sand);
    font-family: var(--font-pixel);
    font-size: 1rem;
    text-align: left;
    cursor: copy;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .finder-command:hover {
    border-color: rgb(230 217 194 / 0.45);
  }
  .finder-command[data-copied] {
    background: rgb(142 213 163 / 0.16);
    color: var(--color-meadow);
  }
</style>
