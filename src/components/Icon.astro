---
/** Small original line icons. Decorative by default (aria-hidden). */
const paths = {
  users:
    '<circle cx="9" cy="8" r="3.25"/><path d="M2.75 19.25c.6-3.3 3.1-5 6.25-5s5.65 1.7 6.25 5"/><circle cx="17" cy="9" r="2.5"/><path d="M17.5 14.3c2 .4 3.3 1.9 3.75 4.2"/>',
  shield:
    '<path d="M12 3.25 4.75 6v5.5c0 4.3 2.9 7.6 7.25 9.25 4.35-1.65 7.25-4.95 7.25-9.25V6z"/><path d="m9 12 2.2 2.2L15.2 10"/>',
  coins:
    '<ellipse cx="9.5" cy="7.5" rx="5.75" ry="2.75"/><path d="M3.75 7.5v4c0 1.5 2.6 2.75 5.75 2.75M3.75 11.5v4c0 1.5 2.6 2.75 5.75 2.75"/><ellipse cx="15" cy="15.5" rx="5.25" ry="2.5"/><path d="M9.75 15.5v2.75c0 1.4 2.35 2.5 5.25 2.5s5.25-1.1 5.25-2.5V15.5"/>',
  home: '<path d="m3.75 11 8.25-7 8.25 7"/><path d="M6 9.5v10h12v-10"/><path d="M10 19.5v-5h4v5"/>',
  compass: '<circle cx="12" cy="12" r="8.75"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>',
  chat: '<path d="M4 5.75h16v10.5h-8.5L7 20v-3.75H4z"/><path d="M8 10h8M8 13h5"/>',
  copy: '<rect x="8.75" y="8.75" width="11" height="11" rx="2"/><path d="M15.25 5.5v-.25a1.5 1.5 0 0 0-1.5-1.5h-8.5a1.5 1.5 0 0 0-1.5 1.5v8.5a1.5 1.5 0 0 0 1.5 1.5h.25"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  external:
    '<path d="M14 4.75h5.25V10"/><path d="M19 5 11 13"/><path d="M17.25 13.5v4.25a1.5 1.5 0 0 1-1.5 1.5h-9.5a1.5 1.5 0 0 1-1.5-1.5v-9.5a1.5 1.5 0 0 1 1.5-1.5h4.25"/>',
  menu: '<path d="M4 7.5h16M4 12h16M4 16.5h16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  map: '<path d="M9 4.75 3.75 6.5v12.75L9 17.5l6 1.75 5.25-1.75V4.75L15 6.5z"/><path d="M9 4.75V17.5M15 6.5v12.75"/>',
} as const;

interface Props {
  name: keyof typeof paths;
  size?: number;
  class?: string;
}
const { name, size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
