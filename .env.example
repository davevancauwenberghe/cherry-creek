# Cherry Creek website configuration. Copy to .env for local development.
# There are no secrets here: the site needs none.

# --- Build time (baked into the static pages; rebuild after changing) -------

# Canonical origin, used for canonical links, Open Graph and the sitemap.
SITE_URL=https://cherrycreek.app

# The address players type into Minecraft. Shown on the site and sent in the
# status handshake.
PUBLIC_SERVER_ADDRESS=play.cherrycreek.app

PUBLIC_MAP_URL=https://map.cherrycreek.app
PUBLIC_DISCORD_URL=https://discord.gg/dRxSt8Bt9t

# --- Run time (read when the server starts; no rebuild needed) --------------

# Set to false to switch the live status feature off entirely.
STATUS_ENABLED=true

# Where the website connects to check the server. Leave empty to use
# PUBLIC_SERVER_ADDRESS. Inside Docker, "localhost" is the container itself,
# not the VPS: use the public address or host.docker.internal instead.
MC_STATUS_HOST=
MC_STATUS_PORT=25565

# How long a status result is reused (10-600 seconds).
STATUS_CACHE_SECONDS=45

# How long to wait for the Minecraft server to answer (500-10000 ms).
STATUS_TIMEOUT_MS=3000

# --- Server -----------------------------------------------------------------

# Interface and port the Node server listens on. The Docker image sets these.
# HOST=127.0.0.1
# PORT=4321

# docker-compose.yaml only: loopback port Apache proxies to.
# HOST_PORT=18082
