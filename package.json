{
  "name": "cherry-creek",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Official website for Cherry Creek, a whitelisted Minecraft Java survival community.",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "art": "node scripts/generate-art.mjs",
    "validate": "npm run lint && npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.12",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.10",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.10.0",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
